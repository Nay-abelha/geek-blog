# Configuração do Banco de Dados MySQL
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=sua_senha
DB_NAME=geek

# Porta do servidor
PORT=3000

# Chave da API OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sua_chave_aqui

# Segredo para assinatura de tokens JWT (use uma string longa e aleatória)
JWT_SECRET=seu_segredo_jwt_muito_longo_e_secreto